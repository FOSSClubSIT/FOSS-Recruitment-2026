# ==============================================================================
# Academic Task & Announcement Aggregator Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- Moodle LMS Web Service Credentials ---
# Base URL of your Moodle portal (without trailing slash)
MOODLE_BASE_URL=https://moodle.university.edu
# Your Moodle login PRN or student username
MOODLE_USERNAME=your_prn_or_username
# Your Moodle account password
MOODLE_PASSWORD=your_moodle_password
# Web service endpoint shortname (defaults to moodle_mobile_app)
MOODLE_SERVICE_SHORTNAME=moodle_mobile_app
# Target batch or section filter (e.g., "Batch C3", "C3")
MOODLE_TARGET_BATCH=Batch C3
# Optional comma-separated specific course IDs to query (e.g. 101,102,105)
MOODLE_COURSE_IDS=

# --- Gemini API (Google GenAI) ---
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model for classification & date extraction
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram Bot Alerts ---
# Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal or channel Chat ID (numeric, e.g., 123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Threshold in hours for classifying approaching deadlines as immediate alerts
URGENT_THRESHOLD_HOURS=48

# --- Gmail API OAuth 2.0 (Optional / Module B) ---
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
GMAIL_SEARCH_QUERY=label:UNREAD newer_than:1d

# --- Storage ---
DATABASE_PATH=data/notifications.db
